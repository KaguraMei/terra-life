{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terra-life.local/schemas/life-save-envelope.schema.json",
  "title": "Terra Life resumable-save envelope (reserved contract)",
  "description": "Protocol reservation only. The current application persists completed-life summaries, not resumable life state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "envelopeVersion", "rulesetVersion", "contentLock", "createdAt", "state", "random", "interactions"],
  "properties": {
    "format": { "const": "terra-life-save" },
    "envelopeVersion": { "const": 1 },
    "rulesetVersion": { "type": "integer", "minimum": 1 },
    "contentLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreVersion", "packages"],
      "properties": {
        "coreVersion": { "type": "string", "minLength": 1 },
        "packages": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "version", "hash"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "hash": { "type": "string", "minLength": 1 } } } }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "state": { "type": "object", "description": "Versioned domain-state DTO; runtime functions, DOM values and prototypes are forbidden." },
    "random": { "type": "object", "additionalProperties": false, "required": ["algorithm", "version", "seed", "state", "draws"], "properties": { "algorithm": { "const": "mulberry32" }, "version": { "const": 1 }, "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "state": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "draws": { "type": "integer", "minimum": 0 } } },
    "interactions": { "type": "object", "additionalProperties": false, "required": ["queue", "pendingDecision"], "properties": { "queue": { "type": "array", "items": { "type": "object", "required": ["at", "type", "id"], "properties": { "at": { "type": "number" }, "type": { "enum": ["ev", "ms", "dec", "cat"] }, "id": { "type": "string", "minLength": 1 }, "payload": {} } } }, "pendingDecision": { "type": ["object", "null"], "description": "Stable definition/option IDs and a versioned interaction snapshot; never closures." } }
    }
  }
}
